rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /items/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /claims/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
